# MongoDB Atlas connection string (same DB for dev and prod)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/mhp?retryWrites=true&w=majority
# Secret for signing the session JWT, at least 32 chars (e.g. `openssl rand -base64 32`)
AUTH_SECRET=replace-with-a-long-random-string

# Used only by `npm run seed` (not needed on Vercel)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Printed prescription letterhead (all optional)
CLINIC_NAME=
CLINIC_TAGLINE=Homeopathic Clinic
CLINIC_ADDRESS=
CLINIC_PHONE=
# Put logo.png in /public and set CLINIC_LOGO_URL=/logo.png
CLINIC_LOGO_URL=
DOCTOR_NAME=
DOCTOR_QUALIFICATIONS=
DOCTOR_REG_NO=

# Daily expiry email (optional): Vercel Cron → /api/cron/expiry-report at 03:00 UTC = 08:00 PKT
CRON_SECRET=
RESEND_API_KEY=
ALERT_EMAIL_TO=
# Must be on a domain verified in Resend (onboarding@resend.dev only delivers to your own Resend account email)
ALERT_EMAIL_FROM=
APP_URL=
